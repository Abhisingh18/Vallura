# =============================================================================
# Valura AI — Environment Configuration Example
# =============================================================================

# Required: Groq API Key for high-speed intent classification
# Get one at https://console.groq.com/
GROQ_API_KEY=gsk_your_key_here

# Optional: OpenAI API Key for high-quality portfolio insights
# Get one at https://platform.openai.com/
OPENAI_API_KEY=sk-your-key-here

# Optional: Model Selection (defaults to llama3-70b-8192 and gpt-4o-mini)
GROQ_MODEL=llama3-70b-8192
OPENAI_MODEL=gpt-4o-mini

# Optional: Port configuration
PORT=8000
HOST=0.0.0.0
